POSTGRES_PASSWORD=change-me
JWT_SECRET=generate-with-openssl-rand-hex-32
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-too
# Web client ID from Google Cloud (same one the Android app uses). Empty = /v1/auth/google returns 501.
GOOGLE_WEB_CLIENT_ID=
# Behind Caddy/Nginx: take client IP from X-Forwarded-For (rate limits).
TRUST_PROXY=1
# Only if delete-account.html is hosted on a different domain than the API.
WEB_ORIGIN=
# ACCESS_TTL=15m
# REFRESH_TTL=1440h
