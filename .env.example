# Domain for the API. Its DNS A record must point to this server's IP. Use localhost to test locally.
DOMAIN=api.example.uz
POSTGRES_PASSWORD=change-me
JWT_SECRET=generate-with-openssl-rand-hex-32
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-too
# Web client ID from Google Cloud (same one the Android app uses). Empty = /v1/auth/google returns 501.
GOOGLE_WEB_CLIENT_ID=
# Only if delete-account.html is hosted on a different domain than the API.
WEB_ORIGIN=
# Swagger UI at /docs is on by default. Set to 1 to turn it off.
# DISABLE_DOCS=1
# ACCESS_TTL=15m
# REFRESH_TTL=1440h
